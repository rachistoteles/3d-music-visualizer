{
    "compilerOptions": {
        "target": "es5",
        "outDir": "./dist",
        "noImplicitAny": true,
        "sourceMap": true,
        "declaration": true,
        "module": "commonjs",
        "strict": true,    "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src"],
    "exclude": [
        "node_modules",
        "dist"
    ]
}